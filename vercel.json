{
  "version": 2,
  "builds": [
    { "src": "proxy.js", "use": "@vercel/node" },
    { "src": "news.js", "use": "@vercel/node" },
    { "src": "sports.js", "use": "@vercel/node" },
    { "src": "movies.js", "use": "@vercel/node" },
    { "src": "suggest.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "games.html", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" },
    { "src": "favicon.ico", "use": "@vercel/static" },
    { "src": "favicon-16.png", "use": "@vercel/static" },
    { "src": "favicon-32.png", "use": "@vercel/static" },
    { "src": "apple-touch-icon.png", "use": "@vercel/static" },
    { "src": "icon-192.png", "use": "@vercel/static" },
    { "src": "icon-512.png", "use": "@vercel/static" },
    { "src": "icon-192-maskable.png", "use": "@vercel/static" },
    { "src": "icon-512-maskable.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/proxy", "dest": "/proxy.js" },
    { "src": "/api/news", "dest": "/news.js" },
    { "src": "/api/sports", "dest": "/sports.js" },
    { "src": "/api/movies", "dest": "/movies.js" },
    { "src": "/api/suggest", "dest": "/suggest.js" },
    {
      "src": "/sw.js",
      "dest": "/sw.js",
      "headers": { "Cache-Control": "no-cache", "Service-Worker-Allowed": "/" }
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json",
      "headers": { "Content-Type": "application/manifest+json" }
    },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
